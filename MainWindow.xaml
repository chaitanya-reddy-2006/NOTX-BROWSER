<Window x:Class="NOTXBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NOTX Browser" Height="820" Width="1320"
        MinHeight="560" MinWidth="850"
        Background="#101116" Foreground="#F3F4F8"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Background" Value="#20222B"/>
            <Setter Property="Foreground" Value="#E8E9EF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#343746"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#E8E9EF"/>
            <Setter Property="Background" Value="#1B1D25"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="2,3,2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                CornerRadius="8,8,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#292C38"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#303341"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>

        <!-- Brand bar -->
        <Border Grid.Row="0" Background="#151720" BorderBrush="#292C36" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="25" Height="25" CornerRadius="7" Background="#8B5CF6" Margin="0,0,9,0">
                        <TextBlock Text="N" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Foreground="White"/>
                    </Border>
                    <TextBlock Text="NOTX" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="  BROWSER" FontSize="10" Foreground="#9296A7"
                               VerticalAlignment="Center" Margin="5,3,0,0"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="FAST  •  SIMPLE  •  PRIVATE"
                           Foreground="#85899A" FontSize="10" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Navigation toolbar -->
        <Grid Grid.Row="1" Background="#191B24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Grid.Column="0" Content="←" Style="{StaticResource ChromeButton}"
                    Click="Back_Click" ToolTip="Back"/>
            <Button x:Name="ForwardButton" Grid.Column="1" Content="→" Style="{StaticResource ChromeButton}"
                    Click="Forward_Click" ToolTip="Forward"/>
            <Button x:Name="ReloadButton" Grid.Column="2" Content="↻" Style="{StaticResource ChromeButton}"
                    Click="Reload_Click" ToolTip="Reload"/>
            <Button Grid.Column="3" Content="⌂" Style="{StaticResource ChromeButton}"
                    Click="Home_Click" ToolTip="Home"/>
            <Border Grid.Column="4" Background="#252833" CornerRadius="10" Margin="10,7,8,7"
                    BorderBrush="#343846" BorderThickness="1">
                <TextBox x:Name="AddressBox" Background="Transparent" Foreground="#F2F3F7"
                         BorderThickness="0" VerticalContentAlignment="Center" Padding="12,0"
                         FontSize="13" CaretBrush="White" KeyDown="AddressBox_KeyDown"
                         ToolTip="Enter a website address or search the web"/>
            </Border>
            <Button Grid.Column="5" Content="Go" Style="{StaticResource ChromeButton}"
                    Background="#7651D5" Click="Go_Click" Margin="0,0,12,0"/>
        </Grid>

        <!-- Tabs and browser content -->
        <TabControl x:Name="BrowserTabs" Grid.Row="2" Background="#101116"
                    BorderThickness="0" SelectionChanged="BrowserTabs_SelectionChanged">
            <TabControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="True"/>
                </ItemsPanelTemplate>
            </TabControl.ItemsPanel>
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="42"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Background="#151720">
                            <Button DockPanel.Dock="Right" Content="+ New tab" Click="NewTab_Click"
                                    Style="{StaticResource ChromeButton}" Margin="5,4,12,4"
                                    Background="#292C38" FontSize="12"/>
                            <TabPanel IsItemsHost="True" VerticalAlignment="Bottom"/>
                        </DockPanel>
                        <Border Grid.Row="1" Background="#101116">
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>
        </TabControl>

        <Border Grid.Row="3" Background="#151720" BorderBrush="#292C36" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,0">
                <TextBlock Text="NOTX Browser" Foreground="#777C8D" FontSize="10" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right" Text="Powered by Microsoft Edge WebView2"
                           Foreground="#777C8D" FontSize="10" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
